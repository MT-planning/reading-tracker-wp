#. Plugin Name of the plugin
msgid "Reading Tracker"
msgstr "Reading Tracker"

#. Description of the plugin
msgid "Adds a reading guide to your site: visitors can dim the page and keep a reading band that follows the pointer."
msgstr "ウェブサイトに読字ガイド（リーディングトラッカー）を追加することができます。"

msgid "Settings"
msgstr "設定"

msgid "Display"
msgstr "表示"

msgid "Where to show"
msgstr "表示する場所"

msgid "Button position"
msgstr "ボタンの位置"

msgid "Features"
msgstr "機能"

msgid "Content area"
msgstr "本文の範囲"

msgid "Initial guide settings"
msgstr "ガイドの初期設定"

msgid "Reading band size"
msgstr "ガイドの大きさ"

msgid "Reading band color"
msgstr "ガイドの色"

msgid "Mask color"
msgstr "マスクの色"

msgid "Options"
msgstr "オプション"

msgid "Text size"
msgstr "文字サイズ"

msgid "Line spacing"
msgstr "行間"

msgid "Font"
msgstr "フォント"

msgid "These are the values visitors see first. Each visitor can change them in the guide panel, and their own settings are saved in their browser."
msgstr "訪問者が最初に使うときの値です。訪問者はガイドのパネルで自由に変更でき、変更した設定はその人のブラウザに保存されます。"

msgid "All pages"
msgstr "すべてのページ"

msgid "Only on single pages of these content types:"
msgstr "次の投稿タイプの個別ページだけ:"

msgid "You can also show or hide the guide on an individual post or page from its edit screen."
msgstr "投稿・固定ページごとの表示／非表示は、それぞれの編集画面でも設定できます。"

msgid "Bottom right"
msgstr "右下"

msgid "Bottom left"
msgstr "左下"

msgid "Top right"
msgstr "右上"

msgid "Top left"
msgstr "左上"

msgid "Corner of the screen where the guide button appears."
msgstr "ガイドのボタンを表示する画面の位置です。"

msgid "Show a \"Hide guide\" button at the top of the screen while the guide is on"
msgstr "ガイドの表示中、画面上部に「ガイドを終了」ボタンを出す"

msgid "Enable keyboard shortcuts (Alt + Shift + G / F, Esc)"
msgstr "キーボードショートカットを使う（Alt + Shift + G / F、Esc）"

msgid "Remember each visitor's settings in their browser"
msgstr "訪問者の設定をその人のブラウザに保存する"

msgid "Keep the guide on when the visitor moves to another page in the same tab"
msgstr "同じタブで別のページに移動しても、ガイドを表示したままにする"

msgid "Let visitors choose from fonts installed on their device (supported browsers only)"
msgstr "訪問者の端末にインストールされたフォントから選べるようにする（対応ブラウザのみ）"

msgid "CSS selector of the area where line spacing and font changes apply. Limiting it to the post content keeps the layout from breaking. Leave empty to apply to the whole page."
msgstr "行間とフォントの変更を反映する範囲の CSS セレクターです。本文に限定するとレイアウトが崩れにくくなります。空欄にするとページ全体に反映します。"

#. translators: 1: minimum, 2: maximum (pixels).
#, php-format
msgid "Height of the band (width in vertical writing mode). %1$d–%2$d px."
msgstr "ガイドの高さ（縦書きのときは幅）。%1$d〜%2$d px。"

msgid "Opacity"
msgstr "不透明度"

msgid "Sharper text (overlay the guide with multiply blending)"
msgstr "文字くっきり（ガイドを乗算で重ねる）"

msgid "Vertical writing mode"
msgstr "縦書き"

msgid "1x (default)"
msgstr "1x（標準）"

#. translators: %s: scale factor such as 1.5 or 2.
#, php-format
msgid "%sx"
msgstr "%sx"

msgid "e.g. BIZ UDPGothic"
msgstr "例: BIZ UDPGothic"

msgid "Leave empty to keep the site's font. The font must be installed on the visitor's device or loaded by your theme."
msgstr "空欄にするとサイトのフォントのままになります。指定するフォントは、訪問者の端末にインストールされているか、テーマで読み込まれている必要があります。"

msgid "Follow the site setting"
msgstr "サイトの設定に従う"

msgid "Show the reading guide"
msgstr "読字ガイドを表示する"

msgid "Hide the reading guide"
msgstr "読字ガイドを表示しない"

msgid "Reading guide on this page"
msgstr "このページの読字ガイド"

msgid "Open reading guide settings"
msgstr "読字ガイドの設定を開く"

msgid "Close settings"
msgstr "設定を閉じる"

msgid "Show guide"
msgstr "ガイドを表示"

msgid "Hide guide"
msgstr "ガイドを終了"

msgid "Expand guide to full screen"
msgstr "ガイドを画面いっぱいに広げる"

msgid "Restore guide size"
msgstr "ガイドの幅を戻す"

msgid "✕ Hide guide"
msgstr "✕ ガイドを終了"

msgid "Guide height (px) and color"
msgstr "ガイドの高さ(px)と色"

msgid "Guide width (px) and color"
msgstr "ガイドの幅(px)と色"

msgid "Sharper text"
msgstr "文字くっきり"

msgid "Writing mode"
msgstr "組み方向"

msgid "Horizontal"
msgstr "横書き"

msgid "Vertical"
msgstr "縦書き"

msgid "* Some sites may not display correctly."
msgstr "※サイトによっては崩れる場合があります。"

msgid "e.g. Verdana"
msgstr "例: BIZ UDPGothic"

msgid "Choose from installed fonts"
msgstr "インストール済みフォントから選ぶ"

msgid "Loading fonts… (allow access if your browser asks)"
msgstr "フォントを読み込んでいます…（許可を求められたら「許可」を選んでください）"

msgid "Could not load the font list. Please type a font name."
msgstr "フォント一覧を取得できませんでした。フォント名を入力してください。"

msgid "No fonts were found."
msgstr "取得できたフォントがありません。"

msgid "Filter fonts"
msgstr "フォントを絞り込む"

msgid "Recommended (UD fonts)"
msgstr "おすすめ（UD フォント）"

msgid "All fonts"
msgstr "すべてのフォント"

msgid "(Use the site's font)"
msgstr "（サイトのフォントのまま）"

msgid "Reset to defaults"
msgstr "設定を初期値に戻す"

msgid "Shortcuts"
msgstr "ショートカット"

msgid "Show / hide guide"
msgstr "ガイドの表示／終了"

msgid "Expand / restore guide"
msgstr "ガイドを広げる／戻す"
